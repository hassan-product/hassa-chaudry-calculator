flowchart TB

  person(["Person<br/>keyboard · mouse or touch · screen reader"])
  clip(["System clipboard"])
  files["Static files: HTML · JS · CSS<br/>loaded once, from the local dev server or dist/"]

  subgraph Tab["Browser tab: the only runtime"]
    direction LR

    subgraph Stack[" "]
    direction TB
    main["main.tsx<br/>mounts ui/App"]

    subgraph UI["ui · components, CSS Modules, tokens"]
      direction LR
      uApp["App.tsx<br/>error boundary"]
      uDisplay["Display.tsx<br/>readout and M indicator"]
      uKeypad["Keypad.tsx<br/>keys and Change sign tooltip"]
      uTape["Tape.tsx"]
      uToggle["TapeToggle.tsx"]
      uAnn["Announcer.tsx<br/>polite live region"]
      uCss["*.module.css · tokens.css"]
    end

    subgraph APP["app · hooks wiring domain to ui"]
      direction LR
      aCalc["useCalculator.ts<br/>holds engine state, the tape and memory"]
      aKey["useKeyboard.ts"]
      aPaste["usePaste.ts"]
      aEmpty["useEmptyTapeConfirm.ts"]
      pageMem["Page memory only<br/>the tape and memory are React state<br/>inside useCalculator, gone on reload"]
    end

    subgraph DOMAIN["domain · pure calculation: no React, no DOM, never throws"]
      direction LR
      dEngine["engine.ts"]
      dEntry["entry.ts"]
      dPaste["paste.ts"]
      dArith["arithmetic.ts"]
      dFormat["format.ts"]
      dTape["tape.ts"]
      dMemory["memory.ts<br/>M+, M−, MR, MC"]
      dValue["value.ts"]
      dResult["result.ts"]
      dDecimal["decimal.ts<br/>the only door to decimal.js:<br/>one clone, precision 34, ROUND_HALF_UP"]
    end


    decimaljs[("decimal.js 10.6.0<br/>npm package")]
    end

    subgraph SHARED["shared · types and constant tables; imports nothing"]
      direction TB
      sMessages["messages.ts"]
      sView["view.ts"]
      sKeys["keys.ts"]
    end

    Stack ~~~ SHARED
  end

  none["Not used anywhere<br/>server · network requests · cookies<br/>localStorage · sessionStorage · IndexedDB"]

  subgraph Key["Legend"]
    direction TB
    k1["A module"]
    k2["Where the tape and memory live"]
    k3["A package from outside the app"]
    k4["Something the app never uses"]
    k5["Thick arrows: imports between layers.<br/>All point inwards, ui → app → domain,<br/>and any layer may use shared."]
    k6["Red dotted arrow with a cross:<br/>an import the rules forbid"]
    k7["Called out: memory logic sits in the domain;<br/>decimal.ts is the single wrapper round decimal.js"]
    k1 ~~~ k7 ~~~ k2 ~~~ k3 ~~~ k4 ~~~ k5 ~~~ k6
  end

  person <-->|"in: keys, clicks, taps<br/>out: display, tape, live-region announcements"| UI
  clip -->|"browser paste event"| aPaste
  files -->|"loaded once at page load"| main
  main --> uApp

  UI ==>|"imports hooks"| APP
  APP ==>|"imports the engine and format"| DOMAIN
  UI ==>|"imports types"| SHARED
  APP ==>|"imports types"| SHARED
  DOMAIN ==>|"imports types and messages"| SHARED
  dDecimal ==>|"the only import of decimal.js"| decimaljs
  UI -. "never imports domain" .-x DOMAIN

  aCalc --- pageMem
  Tab -.- none

  Tab ~~~ Key

